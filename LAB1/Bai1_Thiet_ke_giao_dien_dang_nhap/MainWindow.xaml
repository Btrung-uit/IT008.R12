<Window x:Class="DangNhap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DangNhap"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Khai báo hàng-->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Khai báo cột-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="Đăng Nhập" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="25"/>
        
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tên" VerticalAlignment="Center" FontSize="14" Margin="5"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Mật khẩu" VerticalAlignment="Center" FontSize="14" Margin="3"/>
        
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" x:Name="tbTen" Margin="20,0,20,0" Height="20" FontSize="14" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" x:Name="tbMatKhau" Margin="20,0,20,0" Height="20" FontSize="14" VerticalAlignment="Center"/>

        <Button Grid.Row="5" Grid.Column="3" VerticalAlignment="Center" x:Name="tbOK" Content="OK" Margin="5,0,5,0" FontSize="14" Height="25" Click="btnOK_Click"/>
        <Button Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="2" VerticalAlignment="Center" x:Name="tbCancel" Content="Cancel" Margin="5,0,20,0" FontSize="14" Height="25" Click="btnCancel_Click"/>
    </Grid>
</Window>
